# Camis FIT — Variáveis de ambiente
# Copie este arquivo para .env e preencha os valores
# No Vercel: adicione em Settings > Environment Variables

# ── Banco de Dados (Supabase / Neon / Railway) ──────
DATABASE_URL=postgresql://usuario:senha@host:5432/camisfit?sslmode=require

# ── Autenticação JWT ────────────────────────────────
JWT_SECRET=uma-chave-secreta-longa-e-aleatoria-aqui

# ── Anthropic (Claude IA) ───────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Setup do banco (rota /api/setup/init) ───────────
SETUP_SECRET=outra-chave-secreta-para-inicializar-o-banco

# ── Ambiente ────────────────────────────────────────
NODE_ENV=production

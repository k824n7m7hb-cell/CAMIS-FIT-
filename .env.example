# CamisFIT — Variáveis de ambiente
# Copie para .env e preencha os valores
# No Vercel: adicione em Settings > Environment Variables

# ── Banco de Dados (Supabase Transaction Pooler) ────────────────────────────
# Obtenha em: Supabase > Project Settings > Database > Connection string > URI
DATABASE_URL=postgresql://postgres.SEU_REF:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# ── Autenticação JWT ────────────────────────────────────────────────────────
JWT_SECRET=uma-chave-secreta-longa-e-aleatoria-aqui-minimo-32-chars

# ── Anthropic (Claude IA — Camila) ──────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Setup do banco (rota /api/setup/init) ───────────────────────────────────
SETUP_SECRET=outra-chave-secreta-para-inicializar-o-banco

# ── Email (Gmail SMTP) ──────────────────────────────────────────────────────
GMAIL_USER=camisfitapp@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── Supabase (frontend client — chaves públicas) ────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
EXPO_PUBLIC_API_URL=https://camis-fit.vercel.app/api

# ── Integração de Pagamentos (futuro) ───────────────────────────────────────
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# ASAAS_API_KEY=...

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=sua-chave-resend-aqui
EMAIL_FROM=noreply@seu-dominio.com.br

# ── Ambiente ────────────────────────────────────────────────────────────────
NODE_ENV=production
